<?xml version="1.0" encoding="utf-8"?>
<!--
  Root layout. The freeform map window lives BEHIND this view; the launcher
  owns everything you see here (status bar, divider, media panel, dock).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="false">

    <!-- Wallpaper / ambient background (blurred, dimmed) -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0" />

    <!-- Status bar: rendered as TYPE_APPLICATION_OVERLAY (see CarActivity.setupStatusBarOverlay).
         Kept invisible here so the SplitPanelLayout's marginTop=48dp stays correct. -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="invisible"
        android:background="#88000000">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-light" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/speed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:text="0" />

        <TextView
            android:id="@+id/speed_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:layout_marginStart="4dp"
            android:text="km/h" />

        <!-- Eco score: score + emoji, tap for breakdown popup -->
        <TextView
            android:id="@+id/eco_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="-- 🌿"
            android:textColor="#AAFFFFFF"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Resize panels button: cycles split presets (70/30 → 50/50 → 30/70) -->
        <TextView
            android:id="@+id/btn_resize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="↔"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Gemini / voice assistant button -->
        <ImageView
            android:id="@+id/btn_gemini"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#CCFFFFFF"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#CCFFFFFF"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Split panel container (below status bar, above dock) -->
    <com.glass.auto.SplitPanelLayout
        android:id="@+id/split_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="64dp">

        <!-- Left: map placeholder shown before map app launches -->
        <FrameLayout
            android:id="@+id/map_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:background="#111111">

            <!-- Rounded corner overlay drawn on top of the freeform map window -->
            <View
                android:id="@+id/map_corner_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Shown when no map app is configured -->
            <TextView
                android:id="@+id/map_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#66FFFFFF"
                android:textSize="15sp"
                android:text="Tap ⚙ to select a map app" />
        </FrameLayout>

        <!-- Divider 1 (child index 1) — grab handle between panels -->
        <View
            android:id="@+id/divider"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:background="#99FFFFFF"
            android:clickable="true"
            android:focusable="false" />

        <!-- Media panel — child index 2 (launcher-owned; hidden when a media app is launched as freeform) -->
        <LinearLayout
            android:id="@+id/media_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:background="#CC1A1A2E">

            <!-- Album art + track info — fills full panel width -->
            <LinearLayout
                android:id="@+id/now_playing_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/album_art"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:background="#22FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/track_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="@string/no_media" />

                    <TextView
                        android:id="@+id/track_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#AAFFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Controls inline below artist -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <!-- Play/Pause -->
                        <ImageView
                            android:id="@+id/btn_play_pause"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@android:drawable/ic_media_play"
                            android:tint="#FFFFFFFF"
                            android:padding="8dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Skip next -->
                        <ImageView
                            android:id="@+id/btn_next"
                            android:layout_width="40dp"
                            android:layout_height="44dp"
                            android:src="@android:drawable/ic_media_next"
                            android:tint="#CCFFFFFF"
                            android:padding="8dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Progress bar -->
            <SeekBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:progressTint="#FFFFFFFF"
                android:thumbTint="#FFFFFFFF" />

            <!-- Lyrics scroll -->
            <ScrollView
                android:id="@+id/lyrics_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:fadeScrollbars="true">

                <LinearLayout
                    android:id="@+id/lyrics_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Divider 2 — child index 3 (visible in 3-panel mode only) -->
        <View
            android:id="@+id/divider2"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:background="#99FFFFFF"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="false" />

        <!-- Panel 3 — child index 4: third freeform app (3-panel mode only) -->
        <FrameLayout
            android:id="@+id/panel3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#0A0A0A">

            <TextView
                android:id="@+id/panel3_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:text="Tap ⚙ to select panel 3 app" />
        </FrameLayout>

    </com.glass.auto.SplitPanelLayout>

    <!-- Bottom dock (glass, full width) — holds clock, apps, weather, prayer -->
    <com.glass.auto.DockView
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#CC000000" />

</FrameLayout>
